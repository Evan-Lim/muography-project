% myssp.sty - Style file for Malaysia Science Scholars' Programme (MYSSP) 2026
% Provides identical formatting: title rules, Times font, margins,
% section spacing, abstract environment, acknowledgments.
% Includes section numbering (1, 1.1, 1.2, ...) as in a standard article.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myssp}[2026/01/01 MYSSP 2026 style]

% -------- Package options --------
\newif\if@mysspfinal\@mysspfinalfalse
\DeclareOption{final}{\@mysspfinaltrue}

\newif\if@anonymous\@anonymousfalse
\DeclareOption{anonymous}{\@anonymoustrue}
\DeclareOption{nonanonymous}{\@anonymousfalse}

\ProcessOptions\relax

% -------- Required packages --------
\RequirePackage{geometry}
\RequirePackage{times}
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{fancyhdr}
\RequirePackage{environ}
\RequirePackage{titlesec}
\RequirePackage{caption}

% -------- Page geometry (NeurIPS standard) --------
\geometry{
  letterpaper,
  left=1.5in,
  right=1.5in,
  top=1in,
  bottom=1in,
  headheight=14pt,
  headsep=0.25in,
  footskip=0.3in
}

% -------- Fonts --------
\renewcommand{\rmdefault}{ptm}   % Times
\renewcommand{\sfdefault}{phv}   % Helvetica

% -------- Paragraph formatting --------
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}

% -------- Title formatting (rules like NeurIPS) --------
\newcommand{\@toptitlebar}{\hrule height 4pt \vskip 0.25in \vskip -\parskip}
\newcommand{\@bottomtitlebar}{\vskip 0.29in \vskip -\parskip \hrule height 1pt \vskip 0.09in}

\renewcommand{\maketitle}{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}
    \def\@makefnmark{\hbox to \z@{$^{\@thefnmark}$\hss}}
    \long\def\@makefntext##1{%
      \parindent 1em\noindent
      \hbox to 1.8em{\hss $\m@th ^{\@thefnmark}$}##1
    }
    \thispagestyle{empty}   % no header on first page
    \vbox{%
      \hsize\textwidth
      \linewidth\hsize
      \vskip 0.1in
      \@toptitlebar
      \centering
      {\LARGE\bf \@title\par}
      \@bottomtitlebar
      \if@anonymous
        \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}
          Anonymous Author(s) \\
          Affiliation \\
          Address \\
          \texttt{email} \\
        \end{tabular}%
      \else
        \def\And{%
          \end{tabular}\hfil\linebreak[0]\hfil%
          \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces%
        }
        \def\AND{%
          \end{tabular}\hfil\linebreak[4]\hfil%
          \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces%
        }
        \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\@author\end{tabular}%
      \fi
      \vskip 0.3in \@minus 0.1in
    }
    \@thanks
  \endgroup
  \let\maketitle\relax
  \let\thanks\relax
}

% -------- Abstract environment (NeurIPS style) --------
\renewenvironment{abstract}{%
  \vskip 0.075in%
  \centerline{\large\bf Abstract}%
  \vspace{0.5ex}%
  \begin{quote}%
}{%
  \par%
  \end{quote}%
  \vskip 1ex%
}

% -------- Header and footer (pages after first) --------
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\itshape Malaysia Science Scholar's Programme 2026}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
% No footer text (removed as requested)

% -------- Section formatting WITH NUMBERS (like default article) --------
% Section: 1, 2, 3 ...
\titleformat{\section}
  {\large\bfseries\raggedright}
  {\thesection}
  {1em}
  {}
% Subsection: 1.1, 1.2 ...
\titleformat{\subsection}
  {\normalsize\bfseries\raggedright}
  {\thesubsection}
  {0.8em}
  {}
% Subsubsection: 1.1.1, 1.1.2 ...
\titleformat{\subsubsection}
  {\normalsize\bfseries\raggedright}
  {\thesubsubsection}
  {0.6em}
  {}

% Spacing adjustments (kept from NeurIPS)
\titlespacing*{\section}{0pt}{2.0ex plus 0.5ex minus 0.2ex}{1.5ex plus 0.3ex minus 0.2ex}
\titlespacing*{\subsection}{0pt}{1.8ex plus 0.5ex minus 0.2ex}{0.8ex plus 0.2ex}
\titlespacing*{\subsubsection}{0pt}{1.5ex plus 0.5ex minus 0.2ex}{0.5ex plus 0.2ex}

% -------- List formatting (NeurIPS style) --------
\setlength{\topsep}{4pt plus 1pt minus 2pt}
\setlength{\partopsep}{1pt plus 0.5pt minus 0.5pt}
\setlength{\itemsep}{2pt plus 1pt minus 0.5pt}
\setlength{\parsep}{2pt plus 1pt minus 0.5pt}
\setlength{\leftmargin}{3pc}

% -------- Float placement (NeurIPS style) --------
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.4}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.7}

% -------- Captions --------
\captionsetup{font=small,labelfont=bf,labelsep=period}

% -------- Acknowledgments environment (unnumbered) --------
\newcommand{\acksection}{\section*{Acknowledgments}}
\NewEnviron{ack}{%
  \acksection
  \BODY
}

\endinput
